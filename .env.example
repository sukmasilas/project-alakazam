# Copy this file to .env and fill in real values. Never commit .env itself
# (see .gitignore). Never hardcode a connection string in source.

# Real application database (used by scripts/run_migrations.py and any
# future app code — no web app yet in this milestone).
DATABASE_URL=

# Disposable test database ONLY — the test suite drops/recreates its schema
# against this URL on every run. Must point at a database whose name
# contains "test" (enforced in tests/_db_safety.py). NEVER point this at a
# real/persistent database.
#
# Spin up a disposable instance with:
#   docker run -d --name alakazam-test-pg \
#       -e POSTGRES_USER=alakazam -e POSTGRES_PASSWORD=testpass \
#       -e POSTGRES_DB=alakazam_test -p 55433:5432 postgres:16-alpine
TEST_DATABASE_URL=

# Milestone 3 — web app login gate. Single shared username/password, no
# roles/permissions system (one owner/user prototype — mirrors Project-
# Noctrowl's own APP_LOGIN_USERNAME/APP_LOGIN_PASSWORD pattern under
# Alakazam-specific names). Never commit real values.
ALAKAZAM_LOGIN_USERNAME=CHANGE_ME
ALAKAZAM_LOGIN_PASSWORD=CHANGE_ME

# Random value used only to sign the session cookie — not a credential to
# protect the way the login password is, but still belongs in .env, never
# hardcoded. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ALAKAZAM_SECRET_KEY=CHANGE_ME

# Milestone 4 — the Noctrowl export pipeline (Google Drive upload).
#
# Alakazam uses its OWN, separate Google Cloud OAuth client/token — this
# never reuses Project-Noctrowl's existing OAuth setup. See
# scripts/authorize_google_drive.py for the one-time setup this requires
# (a Google Cloud project + OAuth 2.0 "Desktop app" Client ID that only the
# user can create) and export/drive_client.py for how these are used.

# Path to the OAuth "Desktop app" client-secret JSON downloaded from Google
# Cloud Console (APIs & Services > Credentials > Create Credentials >
# OAuth client ID > Desktop app). Only needed to run
# scripts/authorize_google_drive.py; never read again after that.
ALAKAZAM_GOOGLE_OAUTH_CLIENT_SECRET=

# Path where scripts/authorize_google_drive.py saves the resulting OAuth
# token (including a refresh token) after the one-time interactive consent
# flow. export/drive_client.py reads from this path for every real export
# run and refreshes the access token automatically when it expires. Never
# commit this file — it is gitignored (see .gitignore's secrets/ entry),
# and should be treated like a password.
ALAKAZAM_GOOGLE_OAUTH_TOKEN_PATH=
